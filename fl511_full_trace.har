t:submitLanguageInfo('es-US')\" lang=\"es-US\" hreflang=\"es-US\" aria-label=\"Español\">Español</a>\r\n                    </li>\r\n            </ul>\r\n        </li>\r\n                    <li class=\"loginSection desktop\">    <ul class=\"nav navbar-nav\" role=\"menu\">\r\n        <li role=\"none\"><a href=\"#\" id=\"login-button\" data-testid=\"loginButton\" role=\"menuitem\" data-toggle=\"modal\" data-target=\"#loginModalDialog\" aria-label=\"Log In\">Log In</a></li>\r\n        <li role=\"none\"><a href=\"/my511/register\" id=\"registerLink\">Sign Up<span class='hideForAccessibility'> for an account.</span></a></li>\r\n    </ul>\r\n</li>\r\n                </ul>\r\n\r\n                \r\n\r\n\r\n\r\n<div class=\"menu-width\">\r\n    <ul class=\"nav navbar-nav main-menu\" role=\"menubar\">\r\n                        <li class=\"only511\" role=\"none\">\r\n                            <a data-testid=\"menu-Map-Inde-Map\" href=\"/map\" target=\"_self\" title=\"Map Menu\" role=\"menuitem\">Map</a>\r\n                        </li>\r\n                            <li class=\"dropdown \" role=\"none\">\r\n                                <a data-testid=\"menu-List-Traf\" href=\"/\" class=\"dropdown-toggle\" target=\"_self\" title=\"Traffic Menu\" data-toggle=\"dropdown\" data-hover=\"dropdown\" role=\"menuitem\" aria-expanded=\"false\">\r\n                                    Traffic <span class=\"caret\"></span>\r\n                                </a>\r\n\r\n                                <ul class=\"dropdown-menu\" role=\"menu\" style=\"column-count: 1 \">\r\n                                                    <li role=\"none\">\r\n                    <a data-testid=\"sub-List-ET-TL\" class=\"\" href=\"/list/events/traffic\" target=\"_self\" title=\"Traffic - Incidents List\" data-toggle=\"collapse\" data-target=\".navbar-collapse.in\" role=\"menuitem\">Incidents List</a>\r\n                </li>\r\n                <li role=\"none\">\r\n                    <a data-tes