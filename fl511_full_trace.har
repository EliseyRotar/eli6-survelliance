ewsroom</a>\r\n                    </li>\r\n\r\n\r\n\r\n                            \r\n<li>\r\n    <span>Statewide</span>\r\n    <ul id=\"mobileRegionsPanel\" role=\"menu\">\r\n<li role=\"none\">\r\n                        <a href=\"/region/Statewide\" onclick=\"submitRegionInfo('Statewide', 'ALL', ['28.52', '-81.38', '7'], true); \" role=\"menuitem\">Statewide</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Central\" onclick=\"submitRegionInfo('Central', 'CEN', ['28.52', '-81.38', '8'], true); \" role=\"menuitem\">Central</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Northeast\" onclick=\"submitRegionInfo('Northeast', 'NE', ['30.33', '-81.67', '8'], true); \" role=\"menuitem\">Northeast</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Panhandle\" onclick=\"submitRegionInfo('Panhandle', 'NW', ['30.74', '-85.46', '8'], true); \" role=\"menuitem\">Panhandle</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Southeast\" onclick=\"submitRegionInfo('Southeast', 'SE', ['25.75', '-80.2', '8'], true); \" role=\"menuitem\">Southeast</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Southwest\" onclick=\"submitRegionInfo('Southwest', 'SW', ['26.62', '-81.68', '8'], true); \" role=\"menuitem\">Southwest</a>\r\n                    </li>\r\n<li role=\"none\">\r\n                        <a href=\"/region/Tampa%20Bay\" onclick=\"submitRegionInfo('Tampa Bay', 'TB', ['28.07', '-82.46', '8'], true); \" role=\"menuitem\">Tampa Bay</a>\r\n                    </li>\r\n    </ul>\r\n</li>        <li class=\"languageToggleContainer\" >\r\n<a href=\"javascript:submitLanguageInfo('en')\" class=\"isActive\" lang=\"en\" hreflang=\"en\" aria-label=\"English\">English</a>\r\n<a href=\"javascript:submitLanguageInfo('es-US')\" class=\"\" lang=\"