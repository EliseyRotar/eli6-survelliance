# ELI6 Surveillance System - Environment Configuration Example
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Server configuration
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Camera defaults
DEFAULT_TIMEOUT=10
DEFAULT_DELAY=1.0
CAM_WIDTH=320
CAM_HEIGHT=240

# Performance
USE_THREADING=true
MAX_WORKERS=20
CACHE_MEMORY_MB=256

# Recording
RECORDINGS_DIR=recordings
BACKUP_DIR=backups
CACHE_DIR=cache
